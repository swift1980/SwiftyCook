# Copy this file to .env and fill in real values.
# .env is gitignored - never commit real credentials.

# UI -> API base URL used by nginx in the swiftcookui container
API_URL=http://swiftcookapi:5000

# Optional: origin the API should accept CORS requests from (defaults to
# http://localhost:8080, the UI's docker-compose port, if unset)
API_CORS_ORIGIN=http://localhost:8080

# MariaDB credentials (shared by the mariadb and swiftcookapi services)
DB_ROOT_PASSWORD=change_me
DB_USER=swiftchef
DB_PASSWORD=change_me
DB_NAME=swiftcookdb
